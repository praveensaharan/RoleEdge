# RoleEdge settings. Put your Meta Model API key below, save this file as .env, then start the app (README.md).
# Keep .env to yourself: it holds your key.

META_API_KEY=""

# Every agent runs on Meta models.
ROLEEDGE_PROVIDER="meta"

# ---------------------------------------------------------------- optional

# The model the agents use. Empty = muse-spark-1.3 (standard prices).
# muse-spark-1.3-contributor costs about a tenth as much, but Meta trains on what you send to it. That is fine for
# the made-up demo families here, not for real family data, and it also needs ALLOW_CONTRIBUTOR_MODELS="1".
META_MODEL=""
ALLOW_CONTRIBUTOR_MODELS="0"

# New Studio shares are refused once the app has spent this much on Meta (USD, estimated from token counts).
ROLEEDGE_STUDIO_SPEND_CAP_USD="10"

# Connect a real Gmail and Calendar (a Google Cloud OAuth client, type "Web application", redirect URI
# http://localhost:8100/api/connect/google/callback) or Notion (an internal integration's secret).
# Left empty, the prefilled demo accounts answer instead.
ROLEEDGE_GOOGLE_CLIENT_ID=""
ROLEEDGE_GOOGLE_CLIENT_SECRET=""
NOTION_TOKEN=""
