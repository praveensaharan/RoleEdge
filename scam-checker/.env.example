# Copy to .env and fill in. Never commit .env.

# Meta developer API: only for `python -m scamcheck generate` (writing synthetic data).
META_API_KEY=""
# Optional. The contributor model is cheap, and Meta trains on what is sent: fine for synthetic data only.
META_MODEL="muse-spark-1.3-contributor"
META_RESPONSES_URL="https://api.meta.ai/v1/responses"
